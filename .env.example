# --- Realtime Transcriber config ---
# Copy this file to `.env` and adjust as needed.

# Force a specific compute device: auto | cuda | mps | cpu
TRANSCRIBER_COMPUTE_DEVICE=auto

# Whisper model: tiny | base | small | medium | large-v2 | large-v3
TRANSCRIBER_WHISPER_MODEL=large-v3

# Translation backend: nllb-1.3b | nllb-600m | deepl
TRANSCRIBER_TRANSLATION_BACKEND=nllb-1.3b

# Optional: pin a specific input device name substring (case-insensitive).
# If unset, the auto picker chooses the default system output's loopback.
# TRANSCRIBER_AUDIO_DEVICE_HINT=Speakers

# Target language for translation (ISO-639-1).
TRANSCRIBER_TARGET_LANGUAGE=es

# Optional DeepL API key (only used if backend=deepl).
# DEEPL_API_KEY=

# --- Gemini AI responder (optional) ---
# Get a key at https://aistudio.google.com/app/apikey (free tier available).
# Without a key, the "Responder" button is disabled.
# GEMINI_API_KEY=
TRANSCRIBER_GEMINI_MODEL=gemini-2.5-flash
TRANSCRIBER_AI_HISTORY_SECONDS=60

# Logging level: DEBUG | INFO | WARNING | ERROR
TRANSCRIBER_LOG_LEVEL=INFO
GEMINI_API_KEY=example_key_1234567890
